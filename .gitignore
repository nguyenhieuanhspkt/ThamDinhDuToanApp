# ======================================================
# .gitignore - ThamDinhDuToanApp
# Loại trừ dữ liệu nhạy cảm & file không cần thiết
# ======================================================

# --- THÔNG TIN NHẠY CẢM (Curl, Token, Session) ---
config/
data/config/*.json
data/config/*.xlsx
data/config/*.token
**/curl_command*.txt
**/curl_*.json
**/muasamcong_session.json

# --- CACHE LỚN ---
.erp_cache.json
config/.erp_cache.json
data/.quotes_cache.json
*.cache.json
.*cache.json

# --- DỮ LIỆU DỰ ÁN (data cụ thể, không đưa lên github) ---
data/projects/*/
data/projects/*_files/
data/projects/*.json
data/*_files/

# --- CÁC FILE TESSERACT OCR BINARY ---
*.traineddata

# --- FILE ERP EXCEL LỚN ---
ERP.xlsx

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
venv/
env/

# --- IDE ---
.vscode/
.idea/
*.suo
*.user

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
